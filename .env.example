# PostgreSQL
POSTGRES_USER=evolure
POSTGRES_PASSWORD=troca_esta_password
POSTGRES_DB=evolure_intelligence

# API interna (usada entre serviços: dashboard <-> api, workers <-> api)
INTERNAL_API_KEY=troca_esta_chave

# Dashboard (Next.js)
# NEXT_PUBLIC_API_URL: usado por fetches no browser (fora do Docker)
NEXT_PUBLIC_API_URL=http://localhost:8000
# API_INTERNAL_URL: usado por fetches no servidor Next.js, dentro do container
# (tem de ser o nome do serviço no docker-compose, não "localhost")
API_INTERNAL_URL=http://api:8000

# NextAuth (preencher quando a autenticação do dashboard for implementada)
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# LLM (Fase 5 - Intelligence Engine)
# Gratuito, sem cartão: cria conta em https://aistudio.google.com e gera a chave
GEMINI_API_KEY=

# Contela (Fase 2 - Data Hub)
# DSN de LEITURA à base de dados do Contela (a base real do Contela, não a do Evolure Intelligence)
CONTELA_DATABASE_URL=postgresql://user:password@host:5432/contela_db

# Scheduler (resolve a dívida de correr ingestão/promoção à mão)
INGESTION_INTERVAL_MINUTES=30
